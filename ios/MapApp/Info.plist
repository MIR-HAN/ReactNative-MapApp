<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Mapple</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.lifestyle</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    
    <key>NSCameraUsageDescription</key>
    <string>Mapple needs access to your camera so you can take and share photos of farm stands you discover or update your profile picture.</string>
    
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Mapple uses your location to automatically capture the exact coordinates of a farm stand while you are standing in front of it. For example, this allows you to quickly add a new stand to the map without having to manually enter an address.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Mapple uses your location to accurately place new farm stands on the map and show nearby producers. For example, it automatically identifies your current spot so you can pin a new discovery to the map instantly.</string>
    
    <key>NSMicrophoneUsageDescription</key>
    <string>Mapple needs microphone access only if you choose to record videos of farm stands to share with the community.</string>
    
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Mapple needs access to your photo library so you can upload existing photos of farm stands or update your profile picture.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Mapple would like to save farm stand photos to your library for your future reference.</string>
    
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen.storyboard</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
</dict>
</plist>